rules_version = '2';

// ===============================================================
// Assumed Data Model & Operational Profile
// ===============================================================
//
// Project: mi-propia-contabilidad (Contabilidad Personal PWA)
// Mode: Personal Use / Development (Direct Firestore REST API via Web API Key)
//
// Application Collections:
// 1. accounts: Bank, cash, savings, wallet, and credit card accounts.
//    Document ID: {accountId}
//    Key fields: id, name, type, initialBalance, currentBalance, currency, color, icon
//
// 2. transactions: Income, expense, and transfer records (including split transactions).
//    Document ID: {transactionId}
//    Key fields: id, date, type, accountId, toAccountId, category, categoryCode, amount, description
//
// 3. budgets: Monthly spending limits and alerts.
//    Document ID: {budgetId}
//    Key fields: id, category, categoryCode, limitAmount, spentAmount, month
//
// 4. goals: Personal savings targets and milestones.
//    Document ID: {goalId}
//    Key fields: id, title, targetAmount, currentAmount, deadlineDate, color
//
// 5. planAccounts: Chart of accounts / accounting catalog structure.
//    Document ID: {planAccountId}
//    Key fields: id, code, name, parentCode, isSubaccount, classNumber, classType, groupName, nature
//
// 6. backups: Full serialized state backups and database synchronization payloads.
//    Document ID: {backupId}
//    Key fields: app, version, exportDate, stats, payload, accounts, transactions, budgets, goals, planAccounts
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // Reglas para colecciones principales del sistema contable
    match /accounts/{accountId} {
      allow read, write: if true;
    }

    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    match /budgets/{budgetId} {
      allow read, write: if true;
    }

    match /goals/{goalId} {
      allow read, write: if true;
    }

    match /planAccounts/{planAccountId} {
      allow read, write: if true;
    }

    match /backups/{backupId} {
      allow read, write: if true;
    }

    // Regla global para uso personal / desarrollo con API REST
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
